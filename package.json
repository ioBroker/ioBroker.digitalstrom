{
  "name": "iobroker.digitalstrom",
  "version": "3.0.0",
  "description": "Support for digitalSTROM devices via DSS",
  "author": {
    "name": "Apollon77",
    "email": "iobroker@fischer-ka.de"
  },
  "contributors": [
    {
      "name": "André Schmitz"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.digitalstrom",
  "license": "MIT",
  "keywords": [
    "digitalstrom",
    "digitalSTROM",
    "dss",
    "iot",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.digitalstrom.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "dependencies": {
    "@apollon/iobroker-tools": "^0.3.0",
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-react-v5": "^8.3.3",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.3",
    "@iobroker/types": "^7.2.5",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.7",
    "@vitejs/plugin-react": "^6.3.0",
    "mocha": "^11.7.6",
    "proxyquire": "^2.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.4.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0",
    "diff": "^8.0.4",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "tsx tasks.ts",
    "build:backend": "tsx tasks.ts --backend",
    "build:admin": "tsx tasks.ts --admin",
    "0-clean": "tsx tasks.ts --0-clean",
    "watch": "tsc -p tsconfig.build.json --watch",
    "dev:admin": "vite --config src-admin/vite.config.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p src-admin/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:unit": "mocha --require test/mocha.setup.js \"test/test*.js\"",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:unit && npm run test:package",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.digitalstrom/issues"
  },
  "readmeFilename": "README.md"
}
